# Supabase Configuration (Required for live database, auth, storage, and realtime)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Online Classes Video Provider (LiveKit - optional until Online Classes are enabled)
NEXT_PUBLIC_LIVEKIT_URL="wss://your-livekit-server.livekit.cloud"
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-api-secret"

# APP_URL: Automatically injected in AI Studio runtime
APP_URL = "https://taleemos.taleemos.workers.dev"
